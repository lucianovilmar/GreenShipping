# =======================
# DATABASE CONFIGURATION (SQL Server)
# =======================
DB_HOST=seu_servidor.sql.headcargo.com.br
DB_PORT=9322
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=seu_banco_dados

# =======================
# API CONFIGURATION
# =======================
API_BASE_URL=https://external.dati-api.com/teste
API_KEY=sua_chave_api
API_TIMEOUT=30000
MARITIMO_PUT_ENDPOINT=/agent_destination/maritimo
AEREO_PUT_ENDPOINT=/agent_destination/aereo

# =======================
# WORKER CONFIGURATION
# =======================
# Intervalo em milissegundos (60000 = 1 minuto)
WORKER_INTERVAL=60000
MAX_RETRIES=3
RETRY_DELAY=5000

# =======================
# LOG CONFIGURATION
# =======================
LOG_LEVEL=info
LOG_FILE=logs/integration.log
